// JobMingle Cohort Lead Tracking System — Prisma schema
// See plan: amountPaid defaults to 0 at ingest (form has no payment field);
// startTimeline is captured from the form and mapped to a find-or-created Cohort.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supabase pgbouncer, port 6543) at runtime
  directUrl = env("DIRECT_URL")   // direct (port 5432) for migrations
}

enum Role {
  ADMIN
  SALES_REP
  TUTOR
}

enum Stage {
  NEW
  CALLED
  CLOSED_WON
  CLOSED_LOST
  NO_ANSWER
  SILENT
}

enum FollowUpType {
  INITIAL_CALL
  WHATSAPP
  PRICING_SENT
  PAYMENT_LINK
  PAYMENT_CONFIRMED
  FINAL_FOLLOWUP
  ONBOARDING
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  role           Role     @default(SALES_REP)
  active         Boolean  @default(true)
  lastAssignedAt DateTime?
  createdAt      DateTime @default(now())

  assignedLeads  Lead[]          @relation("AssignedRep")
  notes          Note[]
  activityLog    ActivityLog[]
  followUpsDone  FollowUp[]
  followUpLogs   FollowUpLog[]
  emailCampaigns EmailCampaign[]
  tracksTutored  Track[]         @relation("TrackTutor")
  attendanceTaken Attendance[]
  outreachCampaigns OutreachCampaign[]
}

// A record of each bulk email sent, so admins can revisit past sends.
model EmailCampaign {
  id         String   @id @default(uuid())
  status     String   @default("SENT") // DRAFT | SENT
  subject    String
  body       String
  segment    String?
  trackId    String?
  stage      String?
  cohortId   String?
  recipients Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  sentById   String?
  createdAt  DateTime @default(now())

  sentBy User? @relation(fields: [sentById], references: [id])
}

model Cohort {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  leads Lead[]
}

model Track {
  id      String  @id @default(uuid())
  name    String  @unique
  cost    Decimal @db.Decimal(12, 2)
  active  Boolean @default(true)
  tutorId String?

  tutor        User?        @relation("TrackTutor", fields: [tutorId], references: [id])
  leads        Lead[]       @relation("LeadInterestTrack")
  studentLeads Lead[]       @relation("LeadStudentTrack")
  attendance   Attendance[]
}

// One attendance mark per student (won lead) per class date.
model Attendance {
  id        String   @id @default(uuid())
  leadId    String
  trackId   String
  date      DateTime
  present   Boolean
  byId      String?
  createdAt DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id])
  by    User? @relation(fields: [byId], references: [id])

  @@unique([leadId, date])
  @@index([trackId])
}

model Lead {
  id             String   @id @default(uuid())
  fullName       String
  email          String
  phone          String
  trackId        String
  amountPaid     Decimal  @default(0) @db.Decimal(12, 2)
  balanceLeft    Decimal  @db.Decimal(12, 2)
  howFoundUs     String
  segment        String   @default("APPLICATION") // APPLICATION | SCHOLARSHIP | IMPORTED | ...
  startTimeline  String
  cohortId       String
  assignedRepId  String?
  stage          Stage    @default(NEW)
  closedAt       DateTime?
  studentStatus  String   @default("ACTIVE") // ACTIVE | DROPPED | DEFERRED | COMPLETED
  studentTrackId String?  // track used for tutoring/attendance (set when won)
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  track        Track         @relation("LeadInterestTrack", fields: [trackId], references: [id])
  studentTrack Track?        @relation("LeadStudentTrack", fields: [studentTrackId], references: [id])
  cohort       Cohort        @relation(fields: [cohortId], references: [id])
  assignedRep  User?         @relation("AssignedRep", fields: [assignedRepId], references: [id])
  attendance   Attendance[]
  followUps    FollowUp[]
  followUpLogs FollowUpLog[]
  notes        Note[]
  activityLog  ActivityLog[]

  @@index([cohortId])
  @@index([assignedRepId])
  @@index([stage])
}

// One row per follow-up attempt a closer logs (tap "Reached" / "No answer").
model FollowUpLog {
  id        String   @id @default(uuid())
  leadId    String
  byId      String?
  reached   Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  by   User? @relation(fields: [byId], references: [id])

  @@index([leadId])
}

model FollowUp {
  id            String       @id @default(uuid())
  leadId        String
  type          FollowUpType
  done          Boolean      @default(false)
  completedAt   DateTime?
  completedById String?

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  completedBy User? @relation(fields: [completedById], references: [id])

  @@unique([leadId, type])
}

model Note {
  id        String   @id @default(uuid())
  leadId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
}

// ─── Cold outreach to COMPANIES (the recruitment/placement business line) ─────
// Deliberately separate from Lead/Track/Cohort/EmailCampaign: these are hiring
// companies, not course applicants. Optional text is stored as NULL when the CSV
// left it blank, never "" — the "has this field" send filters are `{ not: null }`
// and blankToNull() in src/lib/outreach.ts is the single enforcement point.

// One named, dated CSV upload. Contacts point at it so a send can be scoped to
// "the batch I imported on the 30th".
model OutreachBatch {
  id         String   @id @default(uuid())
  name       String   @unique
  note       String?
  importedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  contacts CompanyContact[]
}

model CompanyContact {
  id              String    @id @default(uuid())
  email           String    @unique // stored lower-cased and trimmed
  firstName       String?
  companyName     String?
  jobTitle        String?
  industry        String?
  companySize     String?
  location        String?
  hiringRoles     String? // free text -> {{hiring_role}}
  hiringSource    String? // LinkedIn | careers page | job board | ...
  triggerEvent    String? // raised funding | expanding | hiring fast | ...
  personalization String? // one or two hand-written lines
  batchId         String?
  importedAt      DateTime  @default(now())
  unsubscribed    Boolean   @default(false)
  lastEmailedAt   DateTime?
  emailCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  batch OutreachBatch? @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([importedAt])
  @@index([industry])
  @@index([unsubscribed])
}

// A record of each outreach send. Kept out of EmailCampaign so the course-email
// history on /admin/email stays exactly as it was.
model OutreachCampaign {
  id         String   @id @default(uuid())
  status     String   @default("SENT") // DRAFT | SENT
  variant    String? // A | B | C | D, null when hand-written
  fromName   String   @default("JobMingle Limited")
  subject    String
  body       String
  filters    Json?
  recipients Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  sentById   String?
  createdAt  DateTime @default(now())

  sentBy User? @relation(fields: [sentById], references: [id])
}
